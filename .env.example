# supabase secrets set PCLOUD_PASSWORD=yourpassword
# supabase secrets set PCLOUD_API_HOST=api.pcloud.com  # 米国: api.pcloud.com / 欧州: eapi.pcloud.com
# supabase secrets set LINE_CHANNEL_ACCESS_TOKEN=your-token
